{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://intune-policy-auditor.local/schema/knowledge-setting-1.0.json",
  "title": "Intune Policy Auditor knowledge setting",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "canonical_setting_id", "platform", "scope", "display_name", "category", "description",
    "baseline_value", "value_definition", "comparison_rule", "applicability",
    "impact_less_restrictive", "impact_more_restrictive", "aliases", "evidence_sources"
  ],
  "properties": {
    "canonical_setting_id": {"type": "string", "minLength": 5},
    "platform": {"enum": ["windows", "macos", "ios", "ipados", "android", "linux", "unknown"]},
    "scope": {"enum": ["device", "user", "both", "unknown"]},
    "display_name": {"$ref": "#/$defs/localized"},
    "category": {"$ref": "#/$defs/localized"},
    "description": {"$ref": "#/$defs/localized"},
    "baseline_value": true,
    "value_definition": {
      "type": "object",
      "required": ["value_type"],
      "properties": {
        "value_type": {"enum": ["boolean", "integer", "decimal", "string", "enum", "choice", "list", "set", "range", "object", "not_configured", "unknown"]},
        "allowed_values": {"type": "array"},
        "value_labels": {"type": "object"},
        "semantic_mapping": {"type": "object"}
      }
    },
    "comparison_rule": {
      "type": "object",
      "required": ["mode"],
      "properties": {
        "mode": {"enum": ["exact", "ordered", "numeric_minimum", "numeric_maximum", "numeric_range", "set_equals", "set_contains", "list_equals", "custom", "not_orderable"]},
        "ordered_values": {"type": "array"},
        "minimum": {"type": ["number", "null"]},
        "maximum": {"type": ["number", "null"]},
        "custom_rule_id": {"type": ["string", "null"]}
      }
    },
    "applicability": {"type": "object", "required": ["platforms", "scopes"]},
    "impact_less_restrictive": {"$ref": "#/$defs/localized"},
    "impact_more_restrictive": {"$ref": "#/$defs/localized"},
    "restart_behavior": {"$ref": "#/$defs/nullableLocalized"},
    "new_sign_in_behavior": {"$ref": "#/$defs/nullableLocalized"},
    "connectivity_risk": {"$ref": "#/$defs/nullableLocalized"},
    "aliases": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "evidence_sources": {"type": "array", "minItems": 1, "items": {"type": "object"}},
    "severity_if_less_restrictive": {"enum": ["critical", "high", "medium", "low", "information", "none"]}
  },
  "$defs": {
    "localized": {"type": "object", "required": ["de", "en"], "properties": {"de": {"type": "string"}, "en": {"type": "string"}}},
    "nullableLocalized": {"anyOf": [{"$ref": "#/$defs/localized"}, {"type": "null"}]}
  }
}

